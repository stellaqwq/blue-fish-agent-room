# Optional. Copy to .env only if you want settings to survive server restarts.
AGENT_BASE_URL=https://api.deepseek.com/v1
AGENT_MODEL=your-model-id
AGENT_API_KEY=
AGENT_VISION=false
# Local Qwen3 single-action planning requests use reasoning_effort=none in auto.
# Set default to keep your provider's original thinking behavior.
# AGENT_REASONING_EFFORT=default
# AVATAR_PATH=D:/path/to/your/avatar.vrm
# Local proxy Fake-IP compatibility: api.deepseek.com is enabled by default.
# Optional extra trusted HTTPS hostnames, comma-separated (no wildcards/IPs).
# ROOM_MODEL_FAKE_IP_HOSTS=api.example.com
# Local QQ Agent project; its admin credential stays on the server.
# ROOM_QQ_PROJECT=C:/path/to/qq-ai-bot-web
# ROOM_QQ_BASE_URL=http://127.0.0.1:5700
